# IoT Agent 配置模板 — 复制为 .env 并填写实际值

# IDA Pro
IOT_AGENT_IDA_INSTALL_DIR=D:/path/to/IDA
IOT_AGENT_IDA_MCP_URL=http://127.0.0.1:13337/mcp

# Linux VM
IOT_AGENT_VM_SSH_HOST=your-vm-ip
IOT_AGENT_VM_SSH_PORT=22
IOT_AGENT_VM_SSH_USER=ubuntu
IOT_AGENT_VM_SSH_PASSWORD=your-password

# VM asset paths (defaults are fine unless you customized the VM layout)
# IOT_AGENT_VM_FIRMWARE_DIR=/data/firmware
# IOT_AGENT_VM_RUNTIME_DIR=/data/runtime-assets   # chroot 运行时资产（libnvram/busybox）
# IOT_AGENT_DOWNLOAD_MIRROR=https://ghproxy.net/   # GitHub 下载加速镜像（可选）

# Logging
IOT_AGENT_LOG_LEVEL=INFO
